# Copy to e2e/.env.e2e (git-ignored) and fill in a test account with rights on every admin menu.
E2E_USER=
E2E_PASS=

# Admin backend to test against. Default: your local vamc-npl-admin-backend (profile local, port 7200).
# E2E_API_TARGET=http://127.0.0.1:7200
# Vite port used by the run (your `pnpm dev` on 3000 is not touched).
# E2E_PORT=13000
# Number of HTML reports kept under e2e/.report.
# E2E_KEEP_REPORTS=10
