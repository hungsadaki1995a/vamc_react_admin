# API base URL
# Leave empty to call relative /api → Vite proxy (:8080) locally, nginx proxy in production
VITE_API_BASE_URL=http://localhost:8080

# Vite dev proxy target (`/api` → backend). Used only when VITE_API_BASE_URL is empty.
# Default http://127.0.0.1:8080 — local admin backend (vamc-npl-admin-backend) runs on 7200.
# VITE_API_PROXY_TARGET=http://localhost:7200

# Swagger / OpenAPI Spec URL (sử dụng khi chạy `pnpm run api:generate`)
VITE_SWAGGER_URL=http://localhost:8080/v3/api-docs

