# API 베이스 URL
# 빈 값으로 두면 상대경로 /api 로 호출 → 로컬은 Vite 프록시(:8080), 배포는 nginx 프록시
VITE_API_BASE_URL=http://localhost:8080

# Vite dev 프록시 대상 (`/api` → 백엔드). VITE_API_BASE_URL 을 비워 둘 때만 쓰인다.
# 기본값 http://127.0.0.1:8080 — 로컬 admin 백엔드(vamc-npl-admin-backend)는 7200 이다.
# VITE_API_PROXY_TARGET=http://localhost:7200

# 개발 도구(좌측 레일 최하단 🔧) 노출 여부 — 빌드 산출물에만 적용된다.
# `pnpm dev` 는 이 값과 무관하게 항상 노출된다.
# 운영 이미지에서는 반드시 false(또는 미설정) — 내부 API 레퍼런스가 노출된다.
VITE_ENABLE_DEV_TOOLS=false

# Swagger / OpenAPI Spec URL (sử dụng khi chạy `pnpm run api:generate`)
VITE_SWAGGER_URL=http://localhost:8080/v3/api-docs

