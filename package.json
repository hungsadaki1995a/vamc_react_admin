  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "openapi": "openapi-typescript",
    "api:generate:types": "node -e \"['.env', '.env.local'].forEach(f => { try { process.loadEnvFile(f); } catch {} }); const url = process.env.VITE_SWAGGER_URL || process.env.SWAGGER_URL || process.env.OPENAPI_URL || (process.env.VITE_API_BASE_URL ? process.env.VITE_API_BASE_URL.replace(/\\/+$/, '') + '/v3/api-docs' : 'http://192.168.47.250:8080/v3/api-docs'); console.log('Fetching OpenAPI schema from:', url); require('child_process').execSync(`npx openapi-typescript \\\"${url}\\\" -o src/api/swagger.ts`, { stdio: 'inherit' });\""
  },
